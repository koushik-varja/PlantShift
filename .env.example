POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://plantshift:replace-with-a-random-local-password@postgres:5432/plantshift
MQTT_HOST=mosquitto
MQTT_PORT=1883
ADMIN_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
VITE_API_URL=http://localhost:8000

MQTT_BRIDGE_BUFFER=1000
MQTT_BRIDGE_MAX_RETRIES=4
MQTT_BRIDGE_BATCH_SIZE=50
MQTT_BRIDGE_BATCH_FLUSH_MS=50
